{
  "name": "regulaatiotutka",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Regulation Radar — sweep-radar visualization of Finnish and EU legislative change",
  "author": "Jarmo Annala <jarmo.annala@idle.fi>",
  "scripts": {
    "pipeline": "tsx pipeline/index.ts",
    "prebuild": "npm run pipeline",
    "predev": "npm run pipeline",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.pipeline.json --noEmit",
    "bump": "npm version patch --no-git-tag-version"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.0",
    "fast-xml-parser": "^4.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
