{
  "name": "regulaatiotutka",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Regulation Radar — sweep-radar visualization of Finnish and EU legislative change",
  "author": "Jarmo Annala <jarmo.annala@idle.fi>",
  "scripts": {
    "pipeline": "tsx pipeline/index.ts",
    "ensure:data": "tsx pipeline/ensureData.ts",
    "validate:seed": "tsx pipeline/validateSeed.ts",
    "verify:seed": "tsx pipeline/verifySeed.ts",
    "prebuild": "npm run ensure:data",
    "build": "npm run typecheck && vite build",
    "build:all": "npm run pipeline && npm run build",
    "dev": "vite",
    "dev:all": "npm run pipeline && vite",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.pipeline.json --noEmit",
    "bump": "npm version patch --no-git-tag-version"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^26.2.0",
    "fast-xml-parser": "^5.11.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
